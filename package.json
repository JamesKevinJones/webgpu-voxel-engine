{
  "name": "webgpu-voxel-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Chunk-based WebGPU voxel engine with GPU world generation, compute greedy meshing and indirect rendering.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:gpu": "node scripts/gpu-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@webgpu/types": "^0.1.74",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
